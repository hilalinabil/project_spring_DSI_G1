# Local environment for TicketFlow.
# Copy this file to .env (which is git-ignored) and set real values:
#   cp .env.example .env
# Real environment variables (shell, CI, Docker) always win over this file.
# The values below are FAKE placeholders: never commit real secrets.

# Git repository served by the config server (GitHub URL, never a file: URI)
CONFIG_GIT_URI=https://github.com/hilalinabil/ticketFlow-config

# Only if the config repo becomes private. Put real values in .env, never here.
# CONFIG_GIT_USERNAME=your-github-username
# CONFIG_GIT_TOKEN=your-personal-access-token

# MySQL (used by docker compose: mysql container + init script + services)
MYSQL_ROOT_PASSWORD=change-me-root
CUSTOMER_DB_PASSWORD=change-me-customer
EVENT_DB_PASSWORD=change-me-event
BOOKING_DB_PASSWORD=change-me-booking
