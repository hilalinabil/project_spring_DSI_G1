# Local environment for TicketFlow.
# Copy this file to .env (which is git-ignored) and adjust if needed:
#   cp .env.example .env
# Real environment variables (shell, CI, Docker) always win over this file.

# Git repository served by the config server
CONFIG_GIT_URI=https://github.com/hilalinabil/ticketFlow-config

# Only if the config repo becomes private. Put real values in .env, never here.
# CONFIG_GIT_USERNAME=your-github-username
# CONFIG_GIT_TOKEN=your-personal-access-token
